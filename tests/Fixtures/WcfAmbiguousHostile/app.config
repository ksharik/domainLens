<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.serviceModel>
    <client>
      <endpoint
        name="ambiguousClient"
        address="https://example.invalid/ambiguous.svc"
        contract="Fixtures.Wcf.SharedContract"
        binding="basicHttpBinding"
        bindingConfiguration="missingBinding"
        behaviorConfiguration="missingBehavior" />
      <endpoint
        name="unresolvedClient"
        address="https://example.invalid/unresolved.svc"
        contract="Missing.External.IUnresolvedContract"
        binding="madeUpBinding" />
    </client>
    <extensions>
      <behaviorExtensions>
        <add
          name="markerBehavior"
          type="Fixtures.Wcf.AmbiguousHostile.MarkerBehaviorExtension, Fixtures.Wcf.AmbiguousHostile" />
      </behaviorExtensions>
    </extensions>
    <unsupportedElement suspiciousType="System.Diagnostics.Process, System" />
  </system.serviceModel>
</configuration>
