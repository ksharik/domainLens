<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.serviceModel>
    <services>
      <service name="Fixtures.Wcf.Hosting.HostedService" behaviorConfiguration="serviceBehavior">
        <endpoint
          name="hostedEndpoint"
          address="customers"
          contract="Fixtures.Wcf.Hosting.IHostedService"
          binding="basicHttpBinding"
          bindingConfiguration="secureBasic"
          behaviorConfiguration="endpointBehavior">
          <identity>
            <dns value="localhost" />
          </identity>
        </endpoint>
      </service>
    </services>
    <client>
      <endpoint
        name="hostedClient"
        address="https://example.invalid/customer.svc"
        contract="Fixtures.Wcf.Hosting.IHostedService"
        binding="basicHttpBinding"
        bindingConfiguration="secureBasic"
        behaviorConfiguration="endpointBehavior" />
    </client>
    <bindings>
      <basicHttpBinding>
        <binding
          name="secureBasic"
          messageEncoding="Text"
          textEncoding="utf-8"
          transferMode="Buffered"
          maxReceivedMessageSize="65536">
          <security mode="Transport">
            <transport clientCredentialType="Certificate" />
            <message clientCredentialType="UserName" />
          </security>
        </binding>
      </basicHttpBinding>
    </bindings>
    <behaviors>
      <serviceBehaviors>
        <behavior name="serviceBehavior">
          <serviceMetadata httpGetEnabled="false" httpsGetEnabled="true" />
          <serviceDebug includeExceptionDetailInFaults="false" />
        </behavior>
      </serviceBehaviors>
      <endpointBehaviors>
        <behavior name="endpointBehavior">
          <dataContractSerializer maxItemsInObjectGraph="4096" />
        </behavior>
      </endpointBehaviors>
    </behaviors>
    <serviceHostingEnvironment multipleSiteBindingsEnabled="false">
      <serviceActivations>
        <add
          relativeAddress="activated.svc"
          service="Fixtures.Wcf.Hosting.HostedService"
          factory="System.ServiceModel.Activation.ServiceHostFactory, System.ServiceModel.Activation" />
      </serviceActivations>
    </serviceHostingEnvironment>
  </system.serviceModel>
</configuration>
