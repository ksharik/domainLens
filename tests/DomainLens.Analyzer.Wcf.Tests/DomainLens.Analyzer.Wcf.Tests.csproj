<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DomainLens.Core\DomainLens.Core.csproj" />
    <ProjectReference Include="..\..\src\DomainLens.Scanner\DomainLens.Scanner.csproj" />
    <ProjectReference Include="..\..\src\DomainLens.Semantics\DomainLens.Semantics.csproj" />
    <ProjectReference Include="..\..\src\DomainLens.Analyzer.Wcf\DomainLens.Analyzer.Wcf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Fixtures\WcfBasic\**\*"
          Link="Fixtures\WcfBasic\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Fixtures\WcfRich\**\*"
          Link="Fixtures\WcfRich\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Fixtures\WcfInheritance\**\*"
          Link="Fixtures\WcfInheritance\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Fixtures\WcfHostingConfig\**\*"
          Link="Fixtures\WcfHostingConfig\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Fixtures\WcfProgrammatic\**\*"
          Link="Fixtures\WcfProgrammatic\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Fixtures\WcfAmbiguousHostile\**\*"
          Link="Fixtures\WcfAmbiguousHostile\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Fixtures\WcfSharedSource\**\*"
          Link="Fixtures\WcfSharedSource\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
